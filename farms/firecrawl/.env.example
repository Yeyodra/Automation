# Firecrawl farm — env gaps (hub .env is primary)
# Prefix: FIRECRAWL_

# ── Google Account Pool (REQUIRED) ──
# File with Google accounts: one per line, format email:password or email|password
# FIRECRAWL_GOOGLE_ACCOUNTS=./google_accounts.txt

# ── Browser ──
# FIRECRAWL_HEADLESS=true

# ── Timeouts ──
# FIRECRAWL_ACCOUNT_TIMEOUT=180

# ── WARP ──
# FIRECRAWL_WARP_EVERY_N=0

# ── Results ──
# FIRECRAWL_RESULTS_DIR=./results
