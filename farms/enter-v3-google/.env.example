# Enter/Converge v3-google — farm-local overrides (hub .env wins; keep gaps only)
# Copy to .env and edit. All keys are optional: the hub .env already supplies
# shared secrets + ENTER_* provider keys. See ../enter-v3/.env.example too.

# ── Google account pool (REQUIRED) ────────────────────────────────────────────
# One account per line: email|password  (also email:password or email<TAB>password)
# ENTER_GOOGLE_ACCOUNTS=./google_accounts.txt
# ENTER_GOOGLE_USED_FILE=./results/used_google.txt

# ── referral (hub usually provides ENTER_GIFT_CODE) ───────────────────────────
ENTER_GIFT_CODE=
ENTER_INVITER=
ENTER_INVITEE_REWARD=100

# ── referral chain ("estafet") ────────────────────────────────────────────────
# Account #1 claims ENTER_GIFT_CODE; each account's own referral_code becomes the
# next account's gift. Verified: the middle of the chain lands 300 credits
# (100 base + 100 invitee + 100 inviter). Chain is SERIAL: -c is forced to 1.
ENTER_GIFT_CHAIN=0
# On a broken chain (account returned no referral_code) keep farming with the
# seed instead of aborting the batch. Set 0 to fail loudly instead.
ENTER_GIFT_CHAIN_FALLBACK=1
ENTER_CHAIN_STATE=

# credits verification: fresh account = 100 bonus; landed invitee referral = 200.
ENTER_BASE_SIGNUP_CREDITS=100
ENTER_REFERRAL_BONUS_TOTAL=200

# ── Cartethyia Postgres inject ────────────────────────────────────────────────
# Each successful ek_ key is upserted into Cartethyia's provider_accounts
# (provider id "enterconverge") in addition to the local txt/json artifacts.
# Credentials are AES-256-GCM encrypted with CARTETHYIA_ENCRYPTION_KEY, matching
# Cartethyia's own storage. The key + DATABASE_URL are read from
# C:\Users\Novella\Documents\Github\Cartethyia\.env unless overridden here.
# Set 0 to disable (the farm then only writes its own files).
ENTER_CARTETHYIA_INJECT=1
# ENTER_CARTETHYIA_ENV_FILE=C:\Users\Novella\Documents\Github\Cartethyia\.env

# ── browser ───────────────────────────────────────────────────────────────────
ENTER_HEADLESS=true
ENTER_AUTH_MODE=browser

# ── proxy pool (multi-warp SOCKS5 / any proxy) ────────────────────────────────
# One proxy per line in this file; round-robin per account (sticky per account:
# browser + risk-session + post-auth share the same egress).
# multi-warp's warp-pool.txt works verbatim: socks5://127.0.0.1:40001
# ENTER_PROXY_FILE=./proxy.txt
# ENTER_PROXY_POOL=socks5://127.0.0.1:40001,socks5://127.0.0.1:40002
# ENTER_PROXY_SHUFFLE=false
# Probe each proxy's exit IP at batch start and flag duplicates.
# Measured via auth.converge.ai/cdn-cgi/trace so it reports the IP Enter sees.
# ENTER_CHECK_EXIT_IP=true
# ENTER_EXIT_IP_TIMEOUT=20
# Route via the legacy local auth-injecting bridge (only for proxies needing Basic auth).
# ENTER_PROXY_BRIDGE=false
# ENTER_PROXY_BRIDGE_SLOTS=4
# ENTER_PROXY_BRIDGE_BASE_PORT=60000

# ── pacing ────────────────────────────────────────────────────────────────────
ENTER_MAX_ACCOUNTS=1
ENTER_CONCURRENT=1
ENTER_ACCOUNT_GAP=30
ENTER_SPAWN_DELAY=20
ENTER_ACCOUNT_TIMEOUT=600
ENTER_POSTAUTH_TIMEOUT=180
# Per-step ceiling while driving accounts.google.com interstitials.
ENTER_GOOGLE_STEP_TIMEOUT=45

# ── onboarding defaults (HAR-proven v3 values) ────────────────────────────────
ENTER_ONBOARDING_ROLE=founder
ENTER_ONBOARDING_TEAM_SIZE=just_me
ENTER_BUILD_INTENT=other

# ── api key ───────────────────────────────────────────────────────────────────
ENTER_API_KEY_NAME=farm
ENTER_API_KEY_SCOPE=all
ENTER_API_KEY_REVEAL=create_only
