# Enter/Converge v3 — farm-local overrides (hub .env wins; keep gaps only)
# Copy to .env and edit. All keys are optional: hub .env already supplies shared
# secrets + ENTER_* provider keys. See ../enter/.env.example for the full list.

# referral (REQUIRED for real runs; hub usually provides it)
ENTER_GIFT_CODE=
ENTER_INVITER=
ENTER_INVITEE_REWARD=100

# referral chain ("estafet"): account #1 claims ENTER_GIFT_CODE, then each
# account's OWN referral_code becomes the next account's gift. Every claim uses a
# fresh code, which dodges the server-side throttle that silently withholds the
# invitee bonus on heavily-reused codes. Chain is SERIAL: -c is forced to 1.
ENTER_GIFT_CHAIN=0
# On a broken chain (an account returned no referral_code) keep farming with the
# seed instead of aborting the rest of the batch. Set 0 to fail loudly instead.
ENTER_GIFT_CHAIN_FALLBACK=1
ENTER_CHAIN_STATE=

# mailbox — enowX (default) uses the local service on :1430
ENTER_EMAIL_PROVIDER=enowx
ENTER_ENOWX_BASE=http://127.0.0.1:1430
ENTER_ENOWX_DOMAIN=

# mailbox — fluffy: self-hosted Cloudflare Worker temp-mail (clean CF MX)
# ENTER_EMAIL_PROVIDER=fluffy
ENTER_FLUFFY_API=https://temp-mail.nzryeyo.workers.dev
ENTER_FLUFFY_DOMAIN=wowojomok.my.id
ENTER_FLUFFY_API_KEY=

# legacy mailbox fallback (only if ENTER_EMAIL_PROVIDER != enowx)
ENTER_EMAIL_MODE=rotate
ENTER_EMAILQU_DOMAIN=
ENTER_EMAILQU_PREFIX=

# browser
ENTER_HEADLESS=true
ENTER_AUTH_MODE=browser

# pacing
ENTER_MAX_ACCOUNTS=1
ENTER_CONCURRENT=1
ENTER_ACCOUNT_GAP=30
ENTER_SPAWN_DELAY=20
ENTER_OTP_TIMEOUT=180
ENTER_ACCOUNT_TIMEOUT=600
ENTER_POSTAUTH_TIMEOUT=180

# onboarding defaults (HAR-proven v3 values)
ENTER_ONBOARDING_ROLE=founder
ENTER_ONBOARDING_TEAM_SIZE=just_me
ENTER_BUILD_INTENT=other

# api key
ENTER_API_KEY_NAME=farm
ENTER_API_KEY_SCOPE=all
ENTER_API_KEY_REVEAL=create_only

# credits verification: a fresh account holds 100 bonus credits; a landed invitee
# referral raises it to 200. Used to detect silently-withheld bonuses.
ENTER_BASE_SIGNUP_CREDITS=100
ENTER_REFERRAL_BONUS_TOTAL=200

# ── Cartethyia Postgres inject ────────────────────────────────────────────────
# Each successful ek_ key is upserted into Cartethyia's provider_accounts
# (provider id "enterconverge") in addition to the local txt/json artifacts.
# Credentials are AES-256-GCM encrypted with CARTETHYIA_ENCRYPTION_KEY, matching
# Cartethyia's own storage. The key + DATABASE_URL are read from
# C:\Users\Novella\Documents\Github\Cartethyia\.env unless overridden here.
# Set 0 to disable (the farm then only writes its own files).
ENTER_CARTETHYIA_INJECT=1
# ENTER_CARTETHYIA_ENV_FILE=C:\Users\Novella\Documents\Github\Cartethyia\.env
