# ── Automation hub — GLOBAL env (shared by all farms) ───────────────────────
# Copy:  copy .env.example .env
# Runner maps shared keys → GROK_* / ENTER_* / OUTLOOK_* automatically.
# Explicit GROK_* / ENTER_* / OUTLOOK_* here still work and override the shared mapping.

# ── Shared identity / email ─────────────────────────────────────────────────
IMAP_USER=you@gmail.com
IMAP_PASS=xxxx xxxx xxxx xxxx
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# domain | plus_trick | gptmail
# domain/plus_trick → IMAP OTP; gptmail → mail.chatgpt.org.uk API (no IMAP)
EMAIL_MODE=domain
EMAIL_DOMAIN=your-catchall.example
# GPTMAIL_API=https://mail.chatgpt.org.uk
# GPTMAIL_DOMAIN=          # empty = auto public pool; pin optional
# GPTMAIL_PREFIX=
GMAIL_BASE=you@gmail.com

# Password used for farmed accounts
ACCOUNT_PASSWORD=@ChangeMe1

# ── Run defaults ────────────────────────────────────────────────────────────
HEADLESS=true
MAX_ACCOUNTS=1
CONCURRENT=1
SPAWN_DELAY=2
# UI=log
# VERBOSE=true

# ── Proxy (optional) ────────────────────────────────────────────────────────
# PROXY_FILE=./proxies.txt
# PROXY_POOL=
# PROXY_SHUFFLE=false

# ── WARP (hub global IP rotate — enter-farm mid-batch pattern) ──────────────
# WARP_CLI=C:\Program Files\Cloudflare\Cloudflare WARP\warp-cli.exe
# WARP_DISCONNECT_WAIT=3
# WARP_CONNECT_WAIT=8
# WARP_COOLDOWN_AFTER=15
# WARP_MAX_IP_TRIES=4
# WARP_USE_ROTATE_KEYS=true
# Proactive rotate: 0 = off. If >0, hub forces everyN == concurrent (-c).
# Injected as WARP_EVERY_N / GROK_WARP_EVERY_N (+ GROK_CONCURRENT).
# WARP_EVERY_N=3
# WARP_SETTLE_AFTER=8

# ── Optional job-specific overrides ─────────────────────────────────────────
# GROK_PASSWORD=...          # overrides ACCOUNT_PASSWORD for grok only
# GROK_EMAIL_DOMAIN=...
# ENTER_GIFT_CODE=...
# ENTER_EMAIL_MODE=gptmail    # recommended for enter (Auth0 blocks many catch-alls)
# ENTER_HEADLESS=false        # Turnstile more reliable headed
# OUTLOOK_PASSWORD=...       # overrides ACCOUNT_PASSWORD for outlook only
# OUTLOOK_EMAIL_MODE=domain  # domain | plus_trick (IMAP only; no gptmail)
# OUTLOOK_STUB=true          # reserve IMAP email + stub OK until browser automation
