# Railway farm, env gaps (hub .env is primary; hub wins over this file)
#
# The hub injects shared keys (IMAP_*, HEADLESS, PROXY_*, ACCOUNT_TIMEOUT, …)
# into every RAILWAY_* name via core/env.py `_SHARED_MAP`, then overlays this
# file with setdefault only, so anything set in the hub `.env` beats it.
# Leave a key commented unless you genuinely need to override the hub.

# ── Google account pool (REQUIRED) ────────────────────────────────────────────
# One account per line: email|password  (also email:password or email<TAB>password)
# RAILWAY_GOOGLE_ACCOUNTS=./google_accounts.txt
# Accounts already farmed are skipped on later runs.
# RAILWAY_GOOGLE_USED_FILE=./results/used_google.txt

# ── proxy pool (1 account = 1 sticky egress) ──────────────────────────────────
# One proxy per line in the file; browser + every post-auth HTTP call use it.
# multi-warp's warp-pool.txt drops in verbatim (socks5://127.0.0.1:40001).
# RAILWAY_PROXY_FILE=./proxy.txt
# RAILWAY_PROXY_POOL=socks5://127.0.0.1:40001,socks5://127.0.0.1:40002
# RAILWAY_PROXY_SHUFFLE=false
# Probe each proxy's exit IP at batch start and flag duplicates.
# Measured via backboard.railway.com/cdn-cgi/trace (the GraphQL host), not an
# IPv4-only echo: WARP reuses IPv4 anycast exits but gives a unique IPv6, so an
# IPv4-only probe would report false duplicates across a healthy pool.
# RAILWAY_CHECK_EXIT_IP=true
# RAILWAY_EXIT_IP_TIMEOUT=20

# ── browser ───────────────────────────────────────────────────────────────────
# RAILWAY_HEADLESS=true

# ── pacing / timeouts ─────────────────────────────────────────────────────────
# RAILWAY_CONCURRENT=1
# Per-account ceiling (whole browser + post-auth flow).
# RAILWAY_ACCOUNT_TIMEOUT=420
# Ceiling while waiting for one accounts.google.com interstitial.
# RAILWAY_GOOGLE_STEP_TIMEOUT=45

# ── results ───────────────────────────────────────────────────────────────────
# RAILWAY_RESULTS_DIR=./results
# RAILWAY_SCREENSHOT_DIR=./screenshots

# ── Cartethyia inject (optional) ──────────────────────────────────────────────
# Railway sessions are cookie-only (no ek_ API key), so the enterconverge
# injector does not apply. Leaving this on just logs an explicit skip.
# RAILWAY_CARTETHYIA_INJECT=0

# ── WARP (hub injects WARP_EVERY_N; everyN is forced == -c when on) ────────────
# 0 = off. Do not set this by hand when running through the hub.
# RAILWAY_WARP_EVERY_N=0

# ── relay egress (deploy_relay.py: farm account -> Railway TCP proxy) ─────────
# GitHub repo yang di-deploy sebagai buff-relay (owner/name).
# RAILWAY_RELAY_REPO=NetroIndonesia/buff-relay
# Git branch repo relay.
# RAILWAY_RELAY_BRANCH=main
# Port app relay (key tcpProxies yang dibuka).
# RAILWAY_RELAY_PORT=8080
# Kredensial auth relay (dipakai endpoint; kalau kosong, random per service).
# RAILWAY_RELAY_AUTH_USER=relay
# RAILWAY_RELAY_AUTH_PASS=
# Relay/service per akun (1 project per akun, tiap service = egress IP berbeda).
# Plan HOBBY max 5 service/project, jadi nilai ini di-clamp ke 1..5. Default 5.
# RAILWAY_RELAY_PER_ACCOUNT=5
# Path output JSON endpoint (default ./results/relay_endpoints.json).
# RAILWAY_RELAY_ENDPOINTS=./results/relay_endpoints.json
# Append bare proxy URL (http://user:pass@host:port) ke file ini, mis. proxy.txt farm lain.
# RAILWAY_RELAY_PROXY_OUT=
# Jeda antar akun (detik). Railway limit 1 project / 30s per akun; jangan < 30.
# RAILWAY_RELAY_ACCOUNT_GAP=35
